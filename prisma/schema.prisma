// 量化回测系统 Prisma Schema
// 模型：ETF、关联关系、持仓、日K、subscribeShare 原始快照、同步任务状态

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
    code          String @id
    name          String
    trackingIndex String
    trackIndex    String
    scale         Float
    /// 溢价率（百分数，例如 0.02 表示 0.02%）；上游可能为空
    premiumRate   Float?

    @@map("etf")
}

/// 日K线数据
model Kline {
    code          String
    // 格式：YYYYMMDD
    date          Int
    open          Float
    high          Float
    low           Float
    close         Float
    volume        Float
    amount        Float
    change        Float
    changePercent Float

    @@id([code, date])
    @@unique([code, date])
    @@index([code, date])
    @@map("kline")
}

/// 估值
model Valuation {
    code    String
    // "PE", "PB", "PS", "DID"
    type    String
    date    Int
    value   Float
    percent Float
    peg     Float?

    @@id([code, type, date])
    @@index([code, type, date])
    @@map("valuation")
}

/// 行业分布 
model Distribution {
    code            String
    industryName    String
    weight   Float

    @@id([code,industryName])
    @@index([code, industryName])
    @@map("distribution")
}

/// 任务
model Task {
    name       String    @id
    // 任务状态： success/failed
    status     String
    finishedAt DateTime?
    error      String?

    @@map("task")
}

/// 回测运行记录
model BacktestRun {
    id           String   @id @default(cuid())
    strategyKey  String
    params       String
    codes        String
    startDate    Int
    endDate      Int
    status       String
    error        String?
    totalReturn  Float?
    annualReturn Float?
    maxDrawdown  Float?
    sharpe       Float?
    winRate      Float?
    tradeCount   Int?
    createdAt    DateTime @default(now())
    finishedAt   DateTime?
    dailies      BacktestDaily[]
    trade        BacktestTrade?

    @@map("backtest_run")
}

/// 回测每日权益
model BacktestDaily {
    runId     String
    date      Int
    equity    Float
    cash      Float
    positions String
    run       BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

    @@id([runId, date])
    @@index([runId, date])
    @@map("backtest_daily")
}

/// 回测成交明细
model BacktestTrade {
    runId  String @id
    trades String
    run    BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

    @@map("backtest_trade")
}

/// 特征
model Feature {
    code  String
    date  Int
    name  String
    value Float

    @@id([code, name, date])
    @@index([name, date, value])
    @@index([code, name, date])
    @@map("feature")
}
