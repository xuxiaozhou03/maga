// 量化回测系统 Prisma Schema
// 模型：ETF、关联关系、持仓、日K、subscribeShare 原始快照、同步任务状态

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ETF基础信息
model Etf {
  code          String @id
  name          String
  trackingIndex String
  trackIndex    String
  scale         Float
  /// 溢价率（百分数，例如 0.02 表示 0.02%）；上游可能为空
  premiumRate   Float?

  @@map("etf")
}

/// 日K线数据
model Kline {
  code          String
  // 格式：YYYYMMDD
  date          Int
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  amount        Float
  change        Float
  changePercent Float

  @@id([code, date])
  @@unique([code, date])
  @@index([code, date])
  @@map("kline")
}

/// 任务
model Task {
  name      String   @id
  // 任务状态： success/failed
  status    String
  // 信息
  message   String?
  // 完成时间
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task")
}
