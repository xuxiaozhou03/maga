{
  "name": "@maga/db",
  "version": "0.1.0",
  "private": true,
  "description": "存储基础设施：Prisma schema + PrismaClient（不承担业务读写）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.20.0",
    "typescript": "^5.5.4"
  }
}
